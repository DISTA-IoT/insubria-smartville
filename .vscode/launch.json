    "version": "0.2.0",
    "configurations": [
        {
            "name": "REWRITE",
            "type": "python",
            "request": "launch",
            "program": "AttackerNode/scripts/rewrite.py",
            "args": [
                "hajime",
                "192.168.1.9",
                "192.168.1.4",
            ],
            "justMyCode": true
        },
        {
            "name": "REPLAY",
            "type": "python",
            "request": "launch",
            "program": "AttackerNode/scripts/replay.py",
            "args": [
                "AttackerNode/h_scan",
                "192.168.1.5",
                "--repeat",
                "5"
            ],
            "justMyCode": true
        },
        {
            "name": "DISTA Star Topology Generation",
            "type": "python",
            "request": "launch",
            "program": "utils/star_topology.py",
            "args": [
                "override=dista"
            ],
            "justMyCode": true
        },
        {
            "name": "home Star Topology Generation",
            "type": "python",
            "request": "launch",
            "program": "utils/star_topology.py",
            "args": [
                "override=jesus"
            ],
            "justMyCode": false
        },
        {
            "name": "Server Container Manager",
            "type": "python",
            "request": "launch",
            "program": "tiger_container_manager_server.py",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/utils",  // Set the current working directory here

        },
        {
            "name": "Dash",
            "type": "python",
            "request": "launch",
            "program": "dash.py",
            "cwd": "${workspaceFolder}/dashboard",  // Set the current working directory here
            "justMyCode": true,
            "args": [
                "override=jesus"
                ]
        }
    ]
}